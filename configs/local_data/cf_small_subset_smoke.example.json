{
  "schema_version": "0.1.0",
  "dry_run": true,
  "no_download": true,
  "no_training": true,
  "no_network": true,
  "no_outputs": true,
  "no_checkpoints": true,
  "dataset": "Community Forensics-Small",
  "dataset_alias": "CF-Small",
  "local_path_gate": {
    "policy": "symbolic_until_explicit_user_approval",
    "requires_user_approved_local_paths": true,
    "real_local_paths_approved": false,
    "path_mode": "symbolic_only",
    "note": "No real local paths are configured. A real local subset smoke run requires explicit user approval and validated manifests first."
  },
  "manifest_ref": {
    "readiness_gate": "configs/local_data/readiness.example.json",
    "cf_small_manifest": "configs/manifests/community_forensics_small.example.json",
    "manifest_status": "referenced_for_structure_only"
  },
  "subset_plan": {
    "mode": "tiny_symbolic_manifest_rows_only",
    "purpose": "Plan a small CF-Small loader smoke without enumerating files or opening media.",
    "planned_splits": ["train_smoke", "validation_smoke"],
    "file_enumeration": "forbidden",
    "image_reading": "forbidden",
    "mask_reading": "forbidden",
    "recursive_directory_scan": "forbidden"
  },
  "sample_limits": {
    "max_total_manifest_rows": 32,
    "max_train_manifest_rows": 24,
    "max_validation_manifest_rows": 8,
    "max_generator_families": 4,
    "max_models_per_family": 2
  },
  "required_metadata": [
    "architecture",
    "model_name",
    "subset"
  ],
  "holdout_plan": {
    "strategy": "generator_or_model_name_holdout",
    "primary_holdout_key": "model_name",
    "secondary_holdout_key": "architecture",
    "random_only_validation_allowed": false,
    "reason": "Unseen generator generalization is central to CF-Small evaluation, so random-only validation is not sufficient."
  },
  "validation_plan": {
    "scope": "planning_only",
    "checks": [
      "validate symbolic config structure",
      "validate manifest references remain safe",
      "validate required metadata fields are declared",
      "validate holdout strategy before any real local subset run"
    ],
    "read_real_images": false,
    "read_real_masks": false,
    "run_training": false,
    "write_prediction_artifacts": false,
    "write_model_artifacts": false
  },
  "approval": {
    "local_data_approved": false,
    "approved_by": null,
    "approval_date": null,
    "next_step_policy": "Only after explicit user approval, validate local data readiness, validate the CF-Small manifest, and then run a tiny manifest-row-only smoke before any training."
  },
  "forbidden_actions": [
    "dataset download",
    "model training",
    "network access",
    "recursive dataset directory inspection",
    "real image reading",
    "real mask reading",
    "prediction artifact writing",
    "checkpoint artifact writing",
    "package installation",
    "SNS augmentation"
  ],
  "protected_path_exclusions": [
    ".env",
    ".env.*",
    "secrets",
    "data",
    "datasets",
    "outputs",
    "checkpoints"
  ]
}
